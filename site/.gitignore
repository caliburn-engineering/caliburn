node_modules/
dist/
.astro/
.wrangler/

# Compiled Emscripten bundles — build output, not source. Regenerate with
# `npm run sync:demo` (needs the project build tree + emsdk).
public/demo/*

# ...except the frozen linear-analyzer bundle, which is tracked deliberately.
# Nothing regenerates it: the merge that produced Ball-Balancer removed the
# analyzer-only build path, so this is the last copy. The whole point of keeping
# both demos published is that the site is never without something working,
# which only holds if this artifact survives a fresh clone. It is frozen, so it
# costs its ~2 MB exactly once. See its README.
!public/demo/linear-analyzer/
