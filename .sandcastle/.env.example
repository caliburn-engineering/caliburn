# Claude subscription auth — run `claude setup-token` on the host and paste the result here.
CLAUDE_CODE_OAUTH_TOKEN=

# Metered API key — alternative to the subscription token above. Leave commented
# unless you specifically want to bill this run to the API instead of the subscription.
# ANTHROPIC_API_KEY=

# GitHub personal access token — the agent uses it to read and manage GitHub Issues
# Create a fine-grained token: https://github.com/settings/personal-access-tokens/new
# Required repository permissions: Issues (Read and write) and Metadata (Read)
GH_TOKEN=
